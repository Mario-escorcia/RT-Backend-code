# --- Server ---
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed origins for the Angular app
CORS_ORIGIN=http://localhost:4200

# --- PostgreSQL ---
# The database is created automatically on startup if it does not exist.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/knowledge_hub
DATABASE_SSL=false

# --- Research engine ---
# auto      -> uses Claude (web search + analysis) when an Anthropic credential is available, otherwise open data
# claude    -> always Claude
# open-data -> Wikipedia + Wikimedia pageviews + OpenAlex only (free, no key needed)
RESEARCH_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = deeper analysis, slower and more expensive)
RESEARCH_EFFORT=medium
# Maximum number of web searches Claude may run per research
WEB_SEARCH_MAX_USES=6
# Max research requests per hour per user (cost guard)
RESEARCH_RATE_LIMIT_PER_HOUR=30

# --- Authentication ---
# Days a login stays valid
SESSION_DAYS=30
# Secure cookies need HTTPS. Defaults to true when NODE_ENV=production; set false only to test over plain HTTP.
 COOKIE_SECURE=true
# Set to false after creating your account to stop strangers from signing up on a public server
ALLOW_REGISTRATION=true

# --- Deployment ---
# Express "trust proxy" (loopback = Nginx on the same machine)
TRUST_PROXY=loopback
# Absolute or relative path to the Angular build; when set, this server also serves the web app
# FRONTEND_DIST=../frontend/dist/frontend/browser

# --- Open data APIs (optional but recommended) ---
# Contact e-mail sent in the User-Agent to Wikimedia and as "mailto" to OpenAlex (polite pool)
CONTACT_EMAIL=
OPENALEX_API_KEY=
